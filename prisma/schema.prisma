generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum RoleType {
  SYSTEM
  CUSTOM
}

enum RoleScopeType {
  BUSINESS
  BRANCH
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OtpPurpose {
  LOGIN
  REGISTRATION
  PASSWORD_RESET
  PHONE_VERIFICATION
  INVITATION_ACCEPTANCE
  PHONE_CHANGE
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
  CONSUMED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ServiceCategoryStatus {
  ACTIVE
  INACTIVE
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeAssignmentMode {
  CUSTOMER_CHOOSES
  SALON_ASSIGNS
  ANY_AVAILABLE
}

enum DepositPolicyType {
  NONE
  FIXED
  PERCENTAGE
  FULL
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum ProficiencyLevel {
  TRAINEE
  JUNIOR
  SENIOR
  EXPERT
}

enum CustomerStatus {
  ACTIVE
  PENDING_DETAILS
  ARCHIVED
}

model User {
  id              String     @id @default(uuid())
  phone           String     @unique
  passwordHash    String?
  phoneVerifiedAt DateTime?
  status          UserStatus @default(PENDING_VERIFICATION)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships              BusinessMember[]
  sessions                 Session[]
  otpChallenges            OtpChallenge[]
  business                 Business[]
  acceptedInvitations      BusinessInvitation[]       @relation("AcceptedInvitations")
  auditLogs                AuditLog[]
  staffProfiles            Staff[]
  createdCustomers         Customer[]                 @relation("CustomerCreatedBy")
  createdAppointments      Appointment[]              @relation("AppointmentCreatedBy")
  createdExtensions        AppointmentExtension[]     @relation("AppointmentExtensionCreatedBy")
  appointmentStatusHistory AppointmentStatusHistory[] @relation("AppointmentStatusActor")
  reviewedReceipts         PaymentReceipt[]           @relation("ReceiptReviewedBy")
  recordedServiceUsages    ServiceUsage[]             @relation("ServiceUsageRecordedBy")
  recordedPayments         AppointmentPayment[]       @relation("AppointmentPaymentRecordedBy")
  confirmedAppointments    Appointment[]              @relation("AppointmentConfirmedBy")
  reviewedRefunds          RefundRequest[]           @relation("RefundReviewedBy")
  completedRefunds         RefundRequest[]           @relation("RefundCompletedBy")
  createdExpenses          Expense[]                 @relation("ExpenseCreatedBy")

  @@index([phone])
  @@index([status])
}

model Business {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  currency  String         @default("ETB")
  timezone  String         @default("Africa/Addis_Ababa")
  status    BusinessStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  owner_id  String

  // Feedback MVP: master switch for generating feedback requests/notifications
  feedbackEnabled Boolean @default(true)
  feedbackExpiryMode FeedbackExpiryMode @default(DAYS_7)
  feedbackCustomExpiryDays Int?
  user      User           @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  // Branding
  logoUrl            String?
  logoPublicId       String?
  coverImageUrl      String?
  coverImagePublicId String?
  primaryColor       String?
  secondaryColor     String?

  // Public Business Information
  description String?
  aboutUs     String?
  address     String?
  phone       String?
  email       String?
  website     String?

  // Social Media
  facebookUrl  String?
  instagramUrl String?
  telegramUrl  String?
  tiktokUrl    String?

  members           BusinessMember[]
  roles             Role[]
  invitations       BusinessInvitation[]
  branches          Branch[]
  auditLogs         AuditLog[]
  serviceCategories ServiceCategory[]
  services            Service[]
  staff               Staff[]
  customers           Customer[]
  appointments        Appointment[]
  paymentMethods      PaymentMethod[]
  paymentReceipts     PaymentReceipt[]
  serviceUsages       ServiceUsage[]
  appointmentPayments AppointmentPayment[]
  feedbackCategories  FeedbackCategory[]
  feedbackRequests    FeedbackRequest[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]

  @@index([status])
  @@index([slug])
}

model Branch {
  id         String   @id @default(uuid())
  businessId String
  name       String
  address    String?
  email      String?
  timezone   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business               Business                          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userRoleBranches       UserRoleBranch[]
  invitationRoleBranches InvitationRoleBranch[]
  weeklySchedules        BranchWeeklySchedule[]
  dateOverrides          BranchDateOverride[]
  bookingConfig          BranchBookingConfig?
  categoryAssignments    ServiceCategoryBranchAssignment[]
  serviceAssignments  ServiceBranchAssignment[]
  staff               Staff[]
  appointments        Appointment[]
  paymentReceipts     PaymentReceipt[]
  serviceUsages       ServiceUsage[]
  appointmentPayments AppointmentPayment[]
  expenses            Expense[]
  phones              BranchPhone[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([isActive])
}

model BranchPhone {
  id           String   @id @default(uuid())
  branchId     String
  phoneNumber  String
  label        String?
  isPrimary    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, phoneNumber])
  @@unique([branchId, isPrimary])
  @@index([branchId])
  @@index([isActive])
}

model BusinessMember {
  id          String       @id @default(uuid())
  businessId  String
  userId      String
  status      MemberStatus @default(INVITED)
  invitedAt   DateTime     @default(now())
  joinedAt    DateTime?
  suspendedAt DateTime?
  removedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  sentInvitations BusinessInvitation[] @relation("SentInvitations")

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@index([status])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model Role {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String?
  type        RoleType @default(CUSTOM)
  systemKey   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  userRoles       UserRole[]
  invitationRoles InvitationRole[]

  @@unique([businessId, name])
  @@unique([businessId, systemKey])
  @@index([businessId])
  @@index([systemKey])
  @@index([isActive])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  id               String        @id @default(uuid())
  businessMemberId String
  roleId           String
  scopeType        RoleScopeType @default(BUSINESS)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  businessMember BusinessMember   @relation(fields: [businessMemberId], references: [id], onDelete: Cascade)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branches       UserRoleBranch[]

  @@unique([businessMemberId, roleId, scopeType])
  @@index([businessMemberId])
  @@index([roleId])
  @@index([scopeType])
}

model UserRoleBranch {
  userRoleId String
  branchId   String

  userRole UserRole @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userRoleId, branchId])
  @@unique([userRoleId, branchId])
}

model RegistrationRequest {
  id           String    @id @default(uuid())
  phone        String    @unique
  passwordHash String
  businessName String
  currency     String
  timezone     String
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expiresAt    DateTime?

  @@index([phone])
  @@index([status])
}

model OtpChallenge {
  id                    String     @id @default(uuid())
  phone                 String
  purpose               OtpPurpose
  otpHash               String
  verificationTokenHash String?
  status                OtpStatus  @default(PENDING)
  attemptCount          Int        @default(0)
  maxAttempts           Int        @default(5)
  expiresAt             DateTime
  verifiedAt            DateTime?
  consumedAt            DateTime?
  requestIp             String?
  userAgent             String?
  userId                String?
  user                  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt             DateTime   @default(now())

  @@index([phone, purpose, status])
  @@index([expiresAt])
  @@index([userId])
}

model Session {
  id               String        @id @default(uuid())
  userId           String
  refreshTokenHash String
  status           SessionStatus @default(ACTIVE)
  deviceName       String?
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime      @default(now())
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([refreshTokenHash])
}

model BusinessInvitation {
  id                String           @id @default(uuid())
  businessId        String
  phone             String
  tokenHash         String           @unique
  status            InvitationStatus @default(PENDING)
  expiresAt         DateTime
  invitedAt         DateTime         @default(now())
  acceptedAt        DateTime?
  revokedAt         DateTime?
  invitedByMemberId String
  acceptedByUserId  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedByMember BusinessMember   @relation("SentInvitations", fields: [invitedByMemberId], references: [id], onDelete: Cascade)
  acceptedByUser  User?            @relation("AcceptedInvitations", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  roles           InvitationRole[]

  @@index([businessId])
  @@index([phone])
  @@index([status])
  @@index([expiresAt])
  @@index([tokenHash])
  @@index([invitedByMemberId])
}

model InvitationRole {
  id           String        @id @default(uuid())
  invitationId String
  roleId       String
  scopeType    RoleScopeType @default(BUSINESS)
  createdAt    DateTime      @default(now())

  invitation BusinessInvitation     @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branches   InvitationRoleBranch[]

  @@index([invitationId])
  @@index([roleId])
  @@index([scopeType])
}

model InvitationRoleBranch {
  invitationRoleId String
  branchId         String

  invitationRole InvitationRole @relation(fields: [invitationRoleId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([invitationRoleId, branchId])
  @@unique([invitationRoleId, branchId])
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  /// Nullable because system/customer-initiated actions (e.g. a customer
  /// cancelling via their self-service link) have no staff User actor.
  actorId    String?
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model BranchWeeklySchedule {
  id        String   @id @default(uuid())
  branchId  String
  dayOfWeek Int
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch                     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  intervals BranchWeeklyHourInterval[]

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
}

model BranchWeeklyHourInterval {
  id               String   @id @default(uuid())
  weeklyScheduleId String
  startTime        DateTime @db.Time(0)
  endTime          DateTime @db.Time(0)

  weeklySchedule BranchWeeklySchedule @relation(fields: [weeklyScheduleId], references: [id], onDelete: Cascade)

  @@index([weeklyScheduleId])
}

model BranchDateOverride {
  id        String   @id @default(uuid())
  branchId  String
  date      DateTime @db.Date
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch                       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  intervals BranchDateOverrideInterval[]

  @@unique([branchId, date])
  @@index([branchId, date])
}

model BranchDateOverrideInterval {
  id         String   @id @default(uuid())
  overrideId String
  startTime  DateTime @db.Time(0)
  endTime    DateTime @db.Time(0)

  override BranchDateOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@index([overrideId])
}

model BranchBookingConfig {
  id                           String  @id @default(uuid())
  branchId                     String  @unique
  onlineBookingEnabled         Boolean @default(true)
  walkInEnabled                Boolean @default(true)
  bookingApprovalRequired      Boolean @default(false)
  minimumAdvanceBookingMinutes Int     @default(120)
  maximumAdvanceBookingDays    Int     @default(30)
  cancellationWindowMinutes    Int     @default(60)
  reschedulingEnabled          Boolean @default(true)
  bookingBufferMinutes         Int     @default(0)
  waitlistEnabled              Boolean @default(false)

  // Phase 2: Cancellation & Pending Expiration
  customerCancellationEnabled         Boolean          @default(true)
  refundPolicyType                    RefundPolicyType @default(NO_REFUND)
  refundPercentage                    Int?
  pendingAppointmentExpirationMinutes Int              @default(30)

  // Phase 4: Customer Confirmation & Refund
  customerConfirmationEnabled         Boolean          @default(true)
  confirmationReminderHours           Int              @default(24)
  confirmationDeadlineHours           Int              @default(2)
  sameDayConfirmationReminderHours    Int              @default(1)
  customerCancellationPolicy          String           @default("BEFORE_DEADLINE")
  refundDeadlineHours                 Int              @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model ServiceCategory {
  id          String                @id @default(uuid())
  businessId  String
  name        String
  description String?
  status      ServiceCategoryStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  services            Service[]
  branchAssignments   ServiceCategoryBranchAssignment[]
  staffQualifications StaffCategoryQualification[]
  sampleWorks         ServiceCategorySampleWork[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
}

model ServiceCategorySampleWork {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  url         String
  publicId    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model ServiceCategoryBranchAssignment {
  id         String  @id @default(uuid())
  categoryId String
  branchId   String
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([categoryId, branchId])
  @@index([categoryId])
  @@index([branchId])
  @@index([isActive])
}

model Service {
  id                     String                 @id @default(uuid())
  businessId             String
  categoryId             String
  name                   String
  description            String?
  durationMinutes        Int
  price                  Decimal                @db.Decimal(12, 2)
  employeeAssignmentMode EmployeeAssignmentMode
  showPriceToCustomer    Boolean                @default(true)
  depositPolicyType      DepositPolicyType      @default(NONE)
  depositAmount          Decimal?               @db.Decimal(12, 2)
  status                 ServiceStatus          @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  branchAssignments   ServiceBranchAssignment[]
  staffQualifications StaffServiceQualification[]
  appointments        Appointment[]
  serviceUsages       ServiceUsage[]

  @@index([businessId])
  @@index([categoryId])
  @@index([status])
}

model ServiceBranchAssignment {
  id              String   @id @default(uuid())
  serviceId       String
  branchId        String
  isActive        Boolean  @default(true)
  durationMinutes Int?
  price           Decimal? @db.Decimal(12, 2)
  bufferMinutes   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([serviceId, branchId])
  @@index([serviceId])
  @@index([branchId])
  @@index([isActive])
}

model Staff {
  id         String  @id @default(uuid())
  businessId String
  branchId   String
  userId     String?

  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  bio       String?
  status    StaffStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  categoryQualifications StaffCategoryQualification[]
  serviceQualifications  StaffServiceQualification[]
  weeklySchedules        StaffWeeklyScheduleDay[]
  weeklyBreaks           StaffWeeklyBreak[]
  scheduleOverrides      StaffScheduleOverride[]
  breakOverrides         StaffBreakOverride[]
  timeOffs               StaffTimeOff[]
  appointments           AppointmentStaff[]
  appointmentExtensions  AppointmentExtension[]

  @@index([businessId])
  @@index([branchId])
  @@index([status])
  @@index([businessId, branchId])
}

model StaffCategoryQualification {
  id         String   @id @default(uuid())
  staffId    String
  categoryId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff    Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([staffId, categoryId])
  @@index([staffId])
  @@index([categoryId])
}

model StaffServiceQualification {
  id               String           @id @default(uuid())
  staffId          String
  serviceId        String
  proficiencyLevel ProficiencyLevel @default(SENIOR)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

model StaffWeeklyScheduleDay {
  id        String   @id @default(uuid())
  staffId   String
  dayOfWeek Int
  isWorking Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff     Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  intervals StaffWeeklyHours[]

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

model StaffWeeklyHours {
  id            String   @id @default(uuid())
  scheduleDayId String
  intervalStart DateTime @db.Time(0)
  intervalEnd   DateTime @db.Time(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  scheduleDay StaffWeeklyScheduleDay @relation(fields: [scheduleDayId], references: [id], onDelete: Cascade)

  @@index([scheduleDayId])
}

model StaffWeeklyBreak {
  id         String   @id @default(uuid())
  staffId    String
  dayOfWeek  Int
  breakStart DateTime @db.Time(0)
  breakEnd   DateTime @db.Time(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffScheduleOverride {
  id        String   @id @default(uuid())
  staffId   String
  date      DateTime @db.Date
  isWorking Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff     Staff                           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  intervals StaffScheduleOverrideInterval[]

  @@unique([staffId, date])
  @@index([staffId, date])
}

model StaffScheduleOverrideInterval {
  id            String   @id @default(uuid())
  overrideId    String
  intervalStart DateTime @db.Time(0)
  intervalEnd   DateTime @db.Time(0)

  override StaffScheduleOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@index([overrideId])
}

model StaffBreakOverride {
  id        String   @id @default(uuid())
  staffId   String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff     Staff                        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  intervals StaffBreakOverrideInterval[]

  @@unique([staffId, date])
  @@index([staffId, date])
}

model StaffBreakOverrideInterval {
  id         String   @id @default(uuid())
  overrideId String
  breakStart DateTime @db.Time(0)
  breakEnd   DateTime @db.Time(0)

  override StaffBreakOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@index([overrideId])
}

model StaffTimeOff {
  id            String    @id @default(uuid())
  staffId       String
  date          DateTime  @db.Date
  allDay        Boolean   @default(true)
  intervalStart DateTime? @db.Time(0)
  intervalEnd   DateTime? @db.Time(0)
  reason        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
}

model Customer {
  id         String         @id @default(uuid())
  businessId String
  firstName  String
  lastName   String
  status     CustomerStatus @default(ACTIVE)

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  phones           CustomerPhone[]
  appointments     Appointment[]
  paymentReceipts  PaymentReceipt[]
  feedbackRequests FeedbackRequest[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, lastName, firstName])
}

model CustomerPhone {
  id              String  @id @default(uuid())
  businessId      String
  customerId      String
  phone           String
  normalizedPhone String
  isPrimary       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([businessId, normalizedPhone])
  @@index([customerId])
  @@index([businessId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum CustomerConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
}

enum BookingSource {
  ONLINE
  STAFF
  PHONE
  WALK_IN
}

enum AppointmentActorType {
  USER
  SYSTEM
}

model Appointment {
  id             String            @id @default(uuid())
  businessId     String
  branchId       String
  customerId     String
  serviceId      String
  scheduledStart DateTime
  scheduledEnd   DateTime
  actualStart    DateTime?
  actualEnd      DateTime?
  status         AppointmentStatus @default(PENDING)
  totalAmount    Decimal           @db.Decimal(12, 2)
  // Final amount actually agreed/charged after service. Null until finalized.
  // Never overwrites totalAmount (the original/catalog price).
  finalAgreedAmount Decimal?       @db.Decimal(12, 2)
  depositAmount  Decimal?          @db.Decimal(12, 2)
  // Historical refund-policy snapshot captured at appointment creation so later
  // config changes cannot retroactively make an appointment refundable/non-refundable.
  // These are kept for backward compatibility with existing code.
  refundPolicyType   RefundPolicyType?
  refundPercentage   Int?
  refundDeadlineHours Int?
  
  // Refund policy override for this specific appointment.
  // When NULL, the branch's BranchBookingConfig is used (dynamic resolution).
  // When set, this appointment explicitly overrides the branch default.
  // These are NOT a historical snapshot — branch config changes after creation
  // still affect appointments that have no override.
  refundPolicyTypeOverride   RefundPolicyType?
  refundPercentageOverride   Int?
  refundDeadlineHoursOverride Int?
  notes          String?
  internalNotes  String?
  bookingSource  BookingSource     @default(ONLINE)
  createdById    String?
  confirmedAt    DateTime?
  checkedInAt    DateTime?
  inProgressAt   DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  noShowAt       DateTime?
  
  confirmationStatus CustomerConfirmationStatus @default(PENDING)
  customerConfirmedAt DateTime?
  confirmationMethod  String?
  confirmedById       String?

  /// Monotonic version incremented every time the reminder schedule is (re)built
  /// for this appointment. Reminder jobs carry the version they were created for
  /// so stale jobs from a previous schedule can never be delivered after a
  /// reschedule (see AppointmentReminder.scheduleVersion).
  reminderScheduleVersion Int @default(0)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  business           Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch             Branch                     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer           Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service            Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdBy          User?                      @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy        User?                      @relation("AppointmentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  staff              AppointmentStaff[]
  statusHistory      AppointmentStatusHistory[]
  extensions         AppointmentExtension[]
  refundRequests     RefundRequest[]
  serviceUsages      ServiceUsage[]
  paymentReceipts    PaymentReceipt[]
  payments           AppointmentPayment[]
  feedbackRequest    FeedbackRequest?
  reminders          AppointmentReminder[]
  followUps          AppointmentFollowUp[]
  actionTokens       AppointmentActionToken[]

  @@index([businessId])
  @@index([branchId])
  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@index([scheduledStart])
  @@index([branchId, scheduledStart])
}

model AppointmentStaff {
  id            String   @id @default(uuid())
  appointmentId String
  staffId       String
  assignedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  staff       Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, staffId])
  @@index([appointmentId])
  @@index([staffId])
}

/// Operational extension of an appointment that is running longer than scheduled.
/// The appointment's scheduledStart/scheduledEnd are never modified; the latest
/// extension's extendedUntil determines the effective busy end for availability.
model AppointmentExtension {
  id               String   @id @default(uuid())
  appointmentId    String
  staffId          String
  previousEndTime  DateTime
  extendedUntil    DateTime
  extensionMinutes Int
  reason           String?
  createdById      String?
  createdAt        DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  staff       Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("AppointmentExtensionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([staffId])
  @@index([appointmentId, createdAt])
}

model AppointmentStatusHistory {
  id                  String               @id @default(uuid())
  appointmentId       String
  statusFrom          AppointmentStatus?
  statusTo            AppointmentStatus
  actorId             String?
  actorType           AppointmentActorType @default(USER)
  reason              String?
  transitionTimestamp DateTime             @default(now())
  createdAt           DateTime             @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor       User?       @relation("AppointmentStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([transitionTimestamp])
}

enum RefundPolicyType {
  NO_REFUND
  FULL_REFUND
  PARTIAL_REFUND
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Money was actually returned outside Z-Salon and confirmed by staff.
  /// APPROVED alone never means the customer received the money.
  COMPLETED
}

model RefundRequest {
  id               String              @id @default(uuid())
  appointmentId    String
  paymentId        String?
  requestedAmount  Decimal             @db.Decimal(12, 2)
  approvedAmount   Decimal?            @db.Decimal(12, 2)
  status           RefundRequestStatus @default(PENDING)
  requestedAt      DateTime            @default(now())
  reviewedAt       DateTime?
  reviewedById     String?
  reason           String?
  rejectionReason  String?

  // External-refund confirmation (APPROVED -> COMPLETED).
  completedAt        DateTime?
  completedById      String?
  completionReference String?
  completionNote     String?

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  appointment Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  reviewedBy  User?               @relation("RefundReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  completedBy User?               @relation("RefundCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  payment     AppointmentPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([status])
  @@index([paymentId])
}

enum PaymentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentMethod {
  id             String   @id @default(uuid())
  businessId     String
  name           String
  type           String
  accountName    String?
  accountNumber  String?
  instructions   String?
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  receipts            PaymentReceipt[]
  appointmentPayments AppointmentPayment[]
  expenses            Expense[]

  @@index([businessId])
  @@index([isActive])
}

model PaymentReceipt {
  id               String                    @id @default(uuid())
  appointmentId    String
  customerId       String
  businessId       String
  branchId         String
  paymentMethodId  String
  expectedAmount       Decimal                   @db.Decimal(12, 2)
  submittedAmount      Decimal?                  @db.Decimal(12, 2)
  receiptImageUrl      String
  receiptImagePublicId String?
  customerNote         String?
  status               PaymentVerificationStatus @default(PENDING)
  rejectionReason  String?
  submittedAt      DateTime                  @default(now())
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  appointment      Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  paymentMethod    PaymentMethod  @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  reviewedBy       User?          @relation("ReceiptReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([businessId])
  @@index([customerId])
  @@index([status])
}

enum AppointmentPaymentStatus {
  PAID
  VOIDED
  REFUNDED
  PARTIALLY_REFUNDED
}

model AppointmentPayment {
  id              String                   @id @default(uuid())
  appointmentId   String
  businessId      String
  branchId        String
  paymentMethodId String

  amount          Decimal                  @db.Decimal(12, 2)
  status          AppointmentPaymentStatus @default(PAID)
  // How much of this payment has been refunded and confirmed (COMPLETED refunds).
  // Kept separate from `amount` so original payment history is never destroyed.
  refundedAmount  Decimal                  @default(0) @db.Decimal(12, 2)

  reference       String?
  notes           String?

  recordedById    String
  paidAt          DateTime                 @default(now())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  recordedBy    User          @relation("AppointmentPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  refundRequests RefundRequest[]

  @@index([appointmentId])
  @@index([businessId])
  @@index([branchId])
  @@index([paymentMethodId])
  @@index([status])
}

model ServiceUsage {
  id             String   @id @default(uuid())
  appointmentId  String
  businessId     String
  branchId       String

  serviceId      String?
  serviceName    String
  serviceDetails String?

  productsUsed   Json?
  notes          String?

  recordedById   String
  recordedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  recordedBy  User       @relation("ServiceUsageRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@index([businessId])
  @@index([branchId])
  @@index([serviceId])
  @@index([recordedById])
}

// ==========================================================
// Feedback MVP
// ==========================================================

enum FeedbackCategoryType {
  RATING
  TEXT
  BOOLEAN
}

enum FeedbackExpiryMode {
  DAYS_7
  DAYS_15
  DAYS_30
  CUSTOM
  NEVER
}

enum FeedbackRequestStatus {
  PENDING
  SUBMITTED
  EXPIRED
  REVOKED
}

/// A business-defined question/answer dimension for customer feedback.
/// Categories are never deleted; they are disabled so historical responses stay valid.
model FeedbackCategory {
  id          String               @id @default(uuid())
  businessId  String
  name        String
  description String?
  type        FeedbackCategoryType

  // Only meaningful for RATING categories; null for TEXT and BOOLEAN.
  ratingScaleMin Int?
  ratingScaleMax Int?

  isEnabled Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  responses FeedbackResponse[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, isEnabled])
  @@index([businessId, sortOrder])
}

/// A single-use, tokenised invitation to submit feedback for one completed appointment.
/// Only the SHA-256 hash of the raw customer token is ever used for form lookup.
/// The raw token is stored AES-256-GCM encrypted so authorized admins can retrieve the link.
model FeedbackRequest {
  id            String                @id @default(uuid())
  businessId    String
  appointmentId String                @unique
  customerId    String
  tokenHash     String                @unique
  encryptedToken String?
  sentAt        DateTime?
  expiresAt     DateTime?
  status        FeedbackRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  submission  FeedbackSubmission?

  @@index([businessId])
  @@index([appointmentId])
  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
}

/// One completed customer feedback form. Exactly one submission per request.
model FeedbackSubmission {
  id                 String   @id @default(uuid())
  feedbackRequestId  String   @unique
  idempotencyKey     String?
  requestPayloadHash String?
  isAnonymous        Boolean  @default(false)
  submittedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  feedbackRequest FeedbackRequest    @relation(fields: [feedbackRequestId], references: [id], onDelete: Cascade)
  responses       FeedbackResponse[]

  @@index([feedbackRequestId])
  @@index([idempotencyKey])
  @@index([isAnonymous])
  @@index([submittedAt])
}

/// A single answer to one category within a submission.
model FeedbackResponse {
  id                   String  @id @default(uuid())
  feedbackSubmissionId String
  feedbackCategoryId   String
  ratingValue          Int?
  textResponse         String?
  booleanResponse      Boolean?

  createdAt DateTime @default(now())

  feedbackSubmission FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id], onDelete: Cascade)
  feedbackCategory   FeedbackCategory   @relation(fields: [feedbackCategoryId], references: [id], onDelete: Restrict)

  @@unique([feedbackSubmissionId, feedbackCategoryId])
  @@index([feedbackSubmissionId])
  @@index([feedbackCategoryId])
}

// ==========================================================
// Finance: expenses
// ==========================================================

/// Operational payment state of an incurred expense. This is intentionally simple:
/// it distinguishes "incurred" from "actually paid", not double-entry accounting.
/// Durable, PostgreSQL-backed background work for the appointment confirmation
/// workflow. Status values follow the project's existing UPPER_SNAKE enum style.
enum ReminderJobType {
  FIRST_REMINDER
  SECOND_REMINDER
  DEADLINE_FOLLOWUP
}

enum ReminderJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

enum ReminderDeliveryStatus {
  SUCCESS
  FAILED
}

enum FollowUpStatus {
  OPEN
  RESOLVED
  CANCELLED
}

/// Staff resolution outcomes. Intentionally limited to the three supported
/// outcomes; there is no UNREACHABLE outcome.
enum FollowUpOutcome {
  CONFIRMED
  CANCELLED
  RESCHEDULED
}

/// Persisted, revocable opaque token used by the public customer self-service
/// link. Only the SHA-256 hash of the token is stored; the raw token is never
/// persisted or logged.
model AppointmentActionToken {
  id            String    @id @default(uuid())
  businessId    String
  appointmentId String
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([expiresAt])
  @@index([businessId])
}

/// One durable reminder/deadline job per appointment schedule version and type.
/// The worker claims rows with FOR UPDATE SKIP LOCKED; lease fields allow
/// crash recovery.
model AppointmentReminder {
  id                String            @id @default(uuid())
  appointmentId     String
  businessId        String
  branchId          String
  type              ReminderJobType
  status            ReminderJobStatus @default(PENDING)
  scheduledFor      DateTime
  scheduleVersion   Int
  attemptCount      Int               @default(0)
  maxAttempts       Int               @default(5)
  nextAttemptAt     DateTime
  claimedAt         DateTime?
  claimedBy         String?
  leaseExpiresAt    DateTime?
  lastError         String?
  sentAt            DateTime?
  completedAt       DateTime?
  providerMessageId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  appointment Appointment              @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  attempts    ReminderDeliveryAttempt[]

  @@unique([appointmentId, type, scheduleVersion])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([appointmentId])
  @@index([branchId])
}

model ReminderDeliveryAttempt {
  id                String                 @id @default(uuid())
  reminderId        String
  attemptNumber     Int
  status            ReminderDeliveryStatus
  errorMessage      String?
  providerMessageId String?
  createdAt         DateTime               @default(now())

  reminder AppointmentReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
}

/// Durable staff follow-up created when the response deadline passes without a
/// customer acknowledgement. History is preserved: a resolved/cancelled row is
/// never overwritten; a deliberate new contact attempt creates a new row.
model AppointmentFollowUp {
  id              String          @id @default(uuid())
  appointmentId   String
  businessId      String
  branchId        String
  scheduleVersion Int
  status          FollowUpStatus  @default(OPEN)
  reason          String
  deadlineAt      DateTime
  outcome         FollowUpOutcome?
  handledById     String?
  handledAt       DateTime?
  note            String?
  /// Who resolved the follow-up: STAFF or CUSTOMER (self-service).
  resolvedVia     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([branchId, status])
  @@index([appointmentId])
  @@index([status, deadlineAt])
}

enum ExpenseStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  /// Soft-deleted / cancelled expense. Voided expenses are never counted in reports.
  VOIDED
}

/// A business-defined bucket for expenses (rent, utilities, supplies, ...).
/// Categories are never hard-deleted from financial history; they are deactivated.
model ExpenseCategory {
  id          String  @id @default(uuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([isActive])
}

/// One expense incurred by a branch. `amount` is the amount incurred (the accrual);
/// `amountPaid` is how much cash has actually left the business so far. Reports can
/// therefore distinguish incurred vs paid vs unpaid without full accounting.
model Expense {
  id             String        @id @default(uuid())
  businessId     String
  branchId       String
  categoryId     String
  amount         Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  status         ExpenseStatus @default(UNPAID)

  description   String?
  vendor        String?
  receiptNumber String?
  notes         String?

  expenseDate DateTime  @default(now())
  dueDate     DateTime?
  paidAt      DateTime?

  paymentMethodId String?

  // Soft deletion keeps the financial history auditable.
  voidedAt   DateTime?
  voidReason String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([branchId])
  @@index([categoryId])
  @@index([status])
  @@index([expenseDate])
  @@index([businessId, expenseDate])
  @@index([branchId, expenseDate])
}
