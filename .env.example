# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/z_salon?schema=public

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_URL=redis://localhost:6379

# OTP Settings
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_IP_MAX=10
OTP_RATE_LIMIT_IP_WINDOW_MINUTES=15
OTP_RATE_LIMIT_PHONE_MAX=3
OTP_RATE_LIMIT_PHONE_WINDOW_MINUTES=15

# SMS Provider. Only 'console' is implemented today; real production delivery
# is NOT enabled until a provider is added to createSmsProvider().
SMS_PROVIDER=console
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_FROM_NUMBER=+1234567890

# Durable appointment reminder worker (separate process: npm run start:worker)
REMINDER_WORKER_POLL_INTERVAL_MS=30000
REMINDER_WORKER_BATCH_SIZE=20
REMINDER_WORKER_LEASE_SECONDS=120
REMINDER_MAX_ATTEMPTS=5
REMINDER_RETRY_BASE_SECONDS=60
REMINDER_RETRY_MAX_SECONDS=3600
REMINDER_WORKER_RUN_EXPIRATION=true
REMINDER_EXPIRATION_INTERVAL_MINUTES=5
# REMINDER_WORKER_ID=worker-1

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Cookie Settings
COOKIE_SECRET=your-cookie-secret-change-in-production
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_CLEANUP_INTERVAL_MINUTES=60
